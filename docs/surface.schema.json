{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prompt-surface/1.0/schema.json",
  "title": "Prompt Surface Document",
  "type": "object",
  "required": ["version", "state", "root"],
  "properties": {
    "version": {"const": "1.0"},
    "title": {"type": "string"},
    "state": {"type": "object"},
    "root": {"$ref": "#/$defs/node"}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "props": {"type": "object"},
        "bind": {"type": "string", "minLength": 1},
        "when": {"type": "object", "required": ["path"], "properties": {
          "path": {"type": "string"},
          "op": {"enum": ["eq", "neq", "truthy", "falsy", "gt", "gte", "lt", "lte"]},
          "value": {}
        }, "additionalProperties": false},
        "on": {"type": "object", "additionalProperties": {
          "type": "array", "items": {"$ref": "#/$defs/action"}
        }},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["set", "toggle", "increment", "append", "removeAt", "emit"]},
        "path": {"type": "string"},
        "value": {},
        "by": {"type": "number"},
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "payload": {}
      },
      "additionalProperties": false
    }
  }
}
