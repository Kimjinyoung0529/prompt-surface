                            {
                              "key": "state",
                              "label": "Support"
                            }
                          ],
                          "rows": [
                            {
                              "name": "Tabs",
                              "state": "Interactive"
                            },
                            {
                              "name": "Tables",
                              "state": "Responsive"
                            },
                            {
                              "name": "Charts",
                              "state": "SVG"
                            }
                          ]
                        }
                      },
                      {
                        "type": "code",
                        "props": {
                          "text": "<Surface document={ui} theme=\"dark\" />"
