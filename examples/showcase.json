        "children": [
          {
            "type": "card",
            "children": [
              {
                "type": "column",
                "props": {
                  "gap": 14
                },
                "children": [
                  {
                    "type": "heading",
                    "props": {
                      "text": "01 · Compose",
                      "level": 3
                    }
                  },
                  {
                    "type": "text",
                    "props": {
                      "text": "Build complex layouts using nested rows, columns and grids."
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "card",
            "children": [
              {
                "type": "column",
                "props": {
                  "gap": 14
                },
                "children": [
                  {
                    "type": "heading",
                    "props": {
                      "text": "02 · Interact",
                      "level": 3
                    }
                  },
                  {
                    "type": "text",
                    "props": {
                      "text": "Bind UI controls to a single immutable state store."
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "card",
            "children": [
              {
                "type": "column",
                "props": {
                  "gap": 14
                },
                "children": [
                  {
                    "type": "heading",
                    "props": {
                      "text": "03 · Stream",
                      "level": 3
                    }
                  },
                  {
                    "type": "text",
                    "props": {
                      "text": "Use JSONL or SSE to patch parts of the document safely."
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "accordion",
        "id": "gallery-faq",
        "bind": "faq",
        "props": {
          "options": [
            {
              "label": "Can I use another model?",
              "value": "model"
            },
            {
              "label": "Can I add custom React components?",
              "value": "extend"
            }
          ]
        },
        "children": [
          {
            "type": "tab-panel",
            "props": {
              "value": "model"
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Yes. The protocol is a JSON document, independent from your model provider."
                }
              }
            ]
          },
          {
            "type": "tab-panel",
            "props": {
              "value": "extend"
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Yes. Pass a registry of trusted host functions to the Surface component."
                }
              }
            ]
          }
        ]
      }
    ]
  }
